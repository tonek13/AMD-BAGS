# Copy this file to .env.local and fill in the values. .env.local is ignored by git;
# never commit real values. On Vercel, add the same names under Project → Settings → Environment Variables.
# Full walkthrough: docs/SANITY-SETUP.md

# ── Which data the site shows ──────────────────────────────────────────────
# "sanity" = the real shop, read from Sanity (default).
# "demo"   = the built-in SAMPLE bags, labelled as demo data on the page. Never mixed with Sanity.
# If this is "sanity" and the Sanity settings below are missing, the build fails with a clear message
# instead of quietly showing sample products.
SHOP_DATA_SOURCE=sanity

# ── Sanity project (public identifiers, safe to expose) ────────────────────
# Find them at https://www.sanity.io/manage → your project. They are read when the site is BUILT,
# so after changing them on Vercel, redeploy.
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
# A fixed API version (a date) keeps query behaviour from changing under the shop.
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19

# ── Secrets (server only: never prefix these with NEXT_PUBLIC_) ────────────
# Shared secret for the signed webhook that refreshes the site when you publish.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The SAME value goes into the Sanity webhook's "Secret" field.
SANITY_REVALIDATE_SECRET=

# Only needed if the dataset is PRIVATE (the default "production" dataset is public for published content).
# A token with the "Viewer" role is enough. Leave empty otherwise.
SANITY_API_READ_TOKEN=

# Only for the optional one-time import script (npm run import:products). Needs the "Editor" role.
# Use it from your own computer's .env.local only; do NOT add it to Vercel.
SANITY_API_WRITE_TOKEN=

# ── Order emails (Resend: https://resend.com) ──────────────────────────────
# Every order is emailed to the shop owner. Without the first two, "Confirm order" tells the
# customer ordering is not open yet (and the server log says what is missing).
RESEND_API_KEY=
# The shop owner email. Several can be separated by commas.
ORDER_EMAIL_TO=
# Optional sender, e.g. MaisonHook <orders@yourdomain.com> (a domain verified in Resend).
# Leave empty to use Resend's test sender, which can only deliver to your own Resend account email.
ORDER_EMAIL_FROM=

# ── Testing only (leave unset) ─────────────────────────────────────────────
# SANITY_API_HOST=
# SANITY_CDN_BASE_URL=
# NEXT_DIST_DIR=
